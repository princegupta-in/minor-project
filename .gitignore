# Python virtual environment
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/

# Geospatial & Machine Learning Datasets (Large files > 100MB)
data/raw/*
!data/raw/osm_deoghar.json
data/interim/
data/processed/
*.tif
*.tiff
*.npz
*.tar.gz
*.zip

# Keep AOI GeoJSON and OSM vector cache
!data/aoi/
!data/aoi/*.geojson
!data/raw/osm_deoghar.json

# Model Checkpoints & TensorBoard Logs
outputs/checkpoints/
outputs/runs/
outputs/predictions/
*.pt
*.pth
*.onnx

# GIS auxiliary files
*.aux.xml

# Keep QGIS style files
!outputs/maps/*.qml

# OS generated files
.DS_Store
Thumbs.db

